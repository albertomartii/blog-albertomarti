{% extends 'base.html.twig' %}
{% block title %}Blog{% endblock %}
{% block body %}

<div class="container">
    <div class="row">
        {% for post in posts %}
            {{ include('partials/_post.twig.html', {'post': post}) }}
        {% endfor %}
    </div>
    <div class="row">
        {% for recent in recents %}
            {{ include('partials/_recent_post.html.twig', {'recent': recent}) }}
        {% endfor %}
    </div>
</div>

{% endblock %}
