{% if app.user %}
<li><a href="{{ path('app_logout') }}"><i class="fa fa-sign-out sr-icons"></i> {{ app.user.name }} - Logout</a></li>
<li><a href="{{ path('new_post') }}"><i class="fa fa-plus-square sr-icons"></i> New post</a></li>
{% else %}
<li class="{{ route == 'app_login' ? 'active' }}"><a href="{{ path('app_login') }}"><i class="fa fa-sign-in"></i>
        Login</a></li>
<li class="nav-cta"><a href="{{ path('app_register') }}"><i class="fa fa-user-plus"></i> Register</a></li>
{% endif %}