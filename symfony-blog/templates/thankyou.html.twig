{% extends 'base.html.twig' %}

{% block body %}
<div id="thank-you" class="container text-center" style="padding-top: 120px; padding-bottom: 80px;">
    <div class="row">
        <div class="col-md-8 col-md-offset-2">
            <!-- Icono destacado -->
            <div class="icon-box" style="margin-bottom: 20px;">
                <i class="fa fa-check-circle fa-5x text-success" style="color: #28a745;"></i>
            </div>

            <!-- Título y Mensaje -->
            <h1 style="font-weight: bold; margin-bottom: 20px;">Thank You!</h1>
            <p class="lead" style="font-size: 18px; color: #666; margin-bottom: 30px;">
                Your message or request has been successfully received. We will get back to you as soon as possible.
            </p>

            <!-- Botón de acción para volver al inicio -->
            <a href="{{ path('home') }}" class="btn btn-lg btn-primary"
                style="border-radius: 25px; padding: 10px 30px;">
                <i class="fa fa-arrow-left"></i> Back to Home
            </a>
        </div>
    </div>
</div>
{% endblock %}